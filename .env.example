# LLM API Key（推荐方式，不提交到 git）
# 复制本文件为 .env 并填入你的 API Key
# 
# 💡 推荐：使用 DeepSeek 免费额度（新用户注册即送 10 元额度，约 50 万 Token）
# 官网注册：https://platform.deepseek.com/

# 首选：DeepSeek（免费额度充足，性价比高）
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# 备选：Moonshot（Kimi）
# MOONSHOT_API_KEY=your-moonshot-api-key-here

# 备选：OpenAI（需海外信用卡，按量付费）
# OPENAI_API_KEY=your-openai-api-key-here

# 高级配置（一般不需要修改）
# MODEL_NAME=deepseek-chat
# OPENAI_BASE_URL=https://api.deepseek.com/v1
